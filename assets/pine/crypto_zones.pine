        box.new(timestamp(2026,10,12), 53673, timestamp(2026,11,2), 29596, xloc=xloc.bar_time, border_color=color.new(bottomCol, boxesBorderInput), border_width=1, bgcolor=color.new(bottomCol, boxesFillInput))
        label.new(timestamp(2026,11,2), 54746.46, "B4 BEAR BOTTOM\n$43.1k (band $29.6k-$53.7k)\n2026-10-12 -> 2026-11-02", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=color.new(bottomCol, labelsInput), textcolor=color.new(color.white, labelsTextInput), size=size.small)

