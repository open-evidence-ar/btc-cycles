        label.new(timestamp(2025,10,6), 124728, "C4 top (obs) $124.7k\n2025-10-06", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=color.new(c4Col, labelsInput), textcolor=color.new(color.white, labelsTextInput), size=size.small)

        // BTC: reference levels (model centers)
        line.new(timestamp(2009,1,1), 43081, timestamp(2036,1,1), 43081, xloc=xloc.bar_time, style=line.style_dotted, color=color.new(bottomCol, linesInput), width=1)
        line.new(timestamp(2009,1,1), 262873, timestamp(2036,1,1), 262873, xloc=xloc.bar_time, style=line.style_dotted, color=color.new(topCol, linesInput), width=1)

