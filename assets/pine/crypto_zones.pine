        box.new(timestamp(2029,7,31), 338883, timestamp(2029,9,20), 186863, xloc=xloc.bar_time, border_color=color.new(topCol, boxesBorderInput), border_width=1, bgcolor=color.new(topCol, boxesFillInput))
        label.new(timestamp(2029,9,20), 345660.66, "C5 TOP (band)\n$186.9k-$338.9k\n2029-07-31 -> 2029-09-20", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=color.new(topCol, labelsInput), textcolor=color.new(color.white, labelsTextInput), size=size.small)

