        label.new(timestamp(2026,10,22), 43081, "B4 $43.1k", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_diamond, color=color.new(bottomCol, labelsInput), textcolor=color.new(color.white, labelsTextInput), size=size.small)
        label.new(timestamp(2029,8,25), 262873, "C5 $262.9k", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_diamond, color=color.new(topCol, labelsInput), textcolor=color.new(color.white, labelsTextInput), size=size.small)

