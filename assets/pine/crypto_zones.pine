        label.new(timestamp(2030,10,9), 81354.18, "B5 BEAR BOTTOM (re-entry)\n$58.4k-$79.8k\n2030-09-18 -> 2030-10-09", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down, color=color.new(b5Col, labelsInput), textcolor=color.new(color.white, labelsTextInput), size=size.small)

